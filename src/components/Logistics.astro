---
---

<section id="logistics" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="max-w-3xl mb-14">
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-ink uppercase tracking-tight mb-4">
        Alloggio, Mobilità e Quote di Partecipazione
      </h2>
    </div>

    <!-- Logistics Grid -->
    <div class="grid md:grid-cols-2 gap-6 mb-12">

      <!-- Alloggio -->
      <div class="border-[1.5px] border-ink bg-white p-6 shadow-[4px_4px_0px_#1B140E] flex flex-col justify-between">
        <div>
          <h3 class="font-bold text-ink text-lg mb-2">Alloggio Riservato</h3>
          <p class="text-ink-soft text-sm leading-relaxed mb-3">
            <strong>Hotello Padova</strong> – struttura a soli 10 minuti a piedi dalla stazione FS e dalle sedi della scuola: convenzione dedicata di circa 10 camere per i 40 partecipanti fuori sede.
          </p>
        </div>
        <p class="text-[11px] font-mono text-ink-muted pt-3 border-t border-ink/15">
          Opzione senza alloggio disponibile per residenti o organizzati in autonomia.
        </p>
      </div>

      <!-- Vitto e Pasti -->
      <div class="border-[1.5px] border-ink bg-white p-6 shadow-[4px_4px_0px_#1B140E] flex flex-col justify-between">
        <div>
          <h3 class="font-bold text-ink text-lg mb-2">Pasti e Coffee Break</h3>
          <p class="text-ink-soft text-sm leading-relaxed mb-3">
            Pranzi e cene sono inclusi nella quota per tutti i partecipanti (tramite convenzioni, e-coupon mensa universitaria ESU e cena sociale di chiusura al Birrone Padova).
          </p>
        </div>
        <p class="text-[11px] font-mono text-ink-muted pt-3 border-t border-ink/15">
          Diete vegetariane, vegane e celiache gestite nel modulo di registrazione.
        </p>
      </div>

      <!-- Quote di Partecipazione (Col span 2 editorial display) -->
      <div class="border-[1.5px] border-ink bg-paper p-8 shadow-[5px_5px_0px_#1B140E] md:col-span-2">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b-[1.5px] border-ink mb-6">
          <div>
            <h3 class="font-display text-3xl sm:text-4xl text-ink">Quote di Partecipazione</h3>
          </div>
          <div class="font-mono text-xs text-ink-muted max-w-sm">
            Grazie al sostegno istituzionale e ai contributi AISF, le quote coprono le spese vive di soggiorno e didattica.
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-6">
          <!-- Con Alloggio -->
          <div class="border-[1.5px] border-ink bg-white p-6 shadow-[3px_3px_0px_#1B140E] flex flex-col justify-between">
            <div>
              <div class="mb-4">
                <span class="font-display text-4xl sm:text-5xl text-ink block">120 €</span>
                <h4 class="font-bold text-ink text-lg mt-1">Con alloggio</h4>
              </div>
              <ul class="text-xs font-mono text-ink-soft space-y-2 mb-4">
                <li class="flex items-center gap-2">
                  <span class="text-crimson font-bold">✓</span> 4 notti presso Hotello Padova
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-crimson font-bold">✓</span> Tutti i pranzi e cene inclusi (15–19 Marzo)
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-crimson font-bold">✓</span> Kit studente PaThS + Badge ufficiale
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-crimson font-bold">✓</span> Accesso a tutte le lezioni, workshop e uscite
                </li>
              </ul>
            </div>
            <span class="text-[10px] font-mono text-ink-muted block border-t border-ink/10 pt-2">
              Riservata ai 40 partecipanti provenienti da fuori sede.
            </span>
          </div>

          <!-- Senza Alloggio -->
          <div class="border-[1.5px] border-ink bg-white p-6 shadow-[3px_3px_0px_#1B140E] flex flex-col justify-between">
            <div>
              <div class="mb-4">
                <span class="font-display text-4xl sm:text-5xl text-ink block">70 €</span>
                <h4 class="font-bold text-ink text-lg mt-1">Senza alloggio</h4>
              </div>
              <ul class="text-xs font-mono text-ink-soft space-y-2 mb-4">
                <li class="flex items-center gap-2">
                  <span class="text-crimson font-bold">✓</span> Tutti i pranzi e cene inclusi con il gruppo
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-crimson font-bold">✓</span> Kit studente PaThS + Badge ufficiale
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-crimson font-bold">✓</span> Partecipazione a tutte le lezioni e attività sociali
                </li>
                <li class="flex items-center gap-2 text-ink-muted/60">
                  <span>–</span> Alloggio gestito autonomamente dal partecipante
                </li>
              </ul>
            </div>
            <span class="text-[10px] font-mono text-ink-muted block border-t border-ink/10 pt-2">
              Ideale per studenti UniPD o con alloggio autonomo a Padova.
            </span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
