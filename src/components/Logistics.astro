---
---

<section id="logistics" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-16">
      <span class="inline-block text-paths-accent font-mono text-xs font-semibold tracking-widest uppercase mb-3">
        Logistica
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-paths-blue mb-4">
        Alloggio, Spostamenti e Quote
      </h2>
      <div class="w-16 h-1 bg-paths-accent mx-auto rounded-full mb-6"></div>
      <p class="text-gray-500 max-w-2xl mx-auto text-base">
        Tutto è pensato per rendere la tua partecipazione comoda e accessibile.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">

      <!-- Alloggio -->
      <div class="logistics-card bg-paths-bg rounded-2xl border border-gray-200 p-6 hover:border-paths-accent hover:shadow-md transition-all duration-200">
        <div class="w-12 h-12 rounded-xl bg-paths-blue flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
        </div>
        <h3 class="font-bold text-paths-blue text-base mb-3">Alloggio</h3>
        <p class="text-gray-600 text-sm leading-relaxed mb-3">
          <strong>Hotello Padova</strong> – struttura a soli 10 minuti a piedi dalla stazione e dai luoghi dell'evento, riservata per i partecipanti che scelgono la quota con alloggio.
        </p>
        <p class="text-xs text-gray-400 italic">
          Disponibile l'opzione senza alloggio per chi preferisce organizzarsi autonomamente.
        </p>
      </div>

      <!-- Spostamenti -->
      <div class="logistics-card bg-paths-bg rounded-2xl border border-gray-200 p-6 hover:border-paths-accent hover:shadow-md transition-all duration-200">
        <div class="w-12 h-12 rounded-xl bg-paths-blue flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497z" />
          </svg>
        </div>
        <h3 class="font-bold text-paths-blue text-base mb-3">Spostamenti</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          La conformazione di Padova permette di effettuare <strong>tutti gli spostamenti a piedi</strong> senza necessità di trasporti pubblici dedicati. Per l'escursione a Venezia (Mercoledì), verranno acquistati biglietti ferroviari a/r in gruppo.
        </p>
      </div>

      <!-- Vitto e Pasti -->
      <div class="logistics-card bg-paths-bg rounded-2xl border border-gray-200 p-6 hover:border-paths-accent hover:shadow-md transition-all duration-200">
        <div class="w-12 h-12 rounded-xl bg-paths-blue flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.87c1.355 0 2.697.056 4.024.166C17.155 8.51 18 9.473 18 10.608v2.513m-3-4.87v-1.5m-6 1.5v-1.5m12 9.75l-1.5.75a3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0L3 16.5m15-3.38a48.474 48.474 0 00-6-.37c-2.032 0-4.034.125-6 .37m12 0c.39.049.777.102 1.163.16 1.07.16 1.837 1.049 1.837 2.13v.148M9 10.5h.01M15 10.5h.01M9 15h.01M15 15h.01" />
          </svg>
        </div>
        <h3 class="font-bold text-paths-blue text-base mb-3">Vitto e Pasti</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Verranno fornite <strong>convenzioni e indicazioni</strong> per i pasti. Pranzi e cene saranno offerti ai partecipanti durante la scuola, con utilizzo di strutture ed e-coupon mensa universitaria.
        </p>
      </div>

      <!-- Aule -->
      <div class="logistics-card bg-paths-bg rounded-2xl border border-gray-200 p-6 hover:border-paths-accent hover:shadow-md transition-all duration-200">
        <div class="w-12 h-12 rounded-xl bg-paths-blue flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
          </svg>
        </div>
        <h3 class="font-bold text-paths-blue text-base mb-3">Aule e Spazi Didattici</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Aule dipartimentali del Dipartimento di Fisica e Astronomia, spazi della <strong>Scuola Galileiana</strong> e del <strong>Palazzo Bo</strong>.
        </p>
      </div>

      <!-- Quote -->
      <div class="logistics-card bg-paths-bg rounded-2xl border border-gray-200 p-6 hover:border-paths-accent hover:shadow-md transition-all duration-200 md:col-span-2 lg:col-span-2">
        <div class="w-12 h-12 rounded-xl bg-paths-gold flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75" />
          </svg>
        </div>
        <h3 class="font-bold text-paths-blue text-base mb-3">Quote di Iscrizione</h3>
        <div class="space-y-3">
          <div class="flex justify-between items-start py-2.5 border-b border-gray-200">
            <div>
              <span class="text-sm font-semibold text-gray-800 block">Quota con alloggio</span>
              <span class="text-xs text-gray-500">Include alloggio presso Hotello, tutti i pasti e attività</span>
            </div>
            <span class="font-bold text-paths-blue text-base ml-2">120 €</span>
          </div>
          <div class="flex justify-between items-start py-2.5">
            <div>
              <span class="text-sm font-semibold text-gray-800 block">Quota senza alloggio</span>
              <span class="text-xs text-gray-500">Include tutti i pasti (pranzi e cene) e tutte le attività sociali</span>
            </div>
            <span class="font-bold text-paths-blue text-base ml-2">70 €</span>
          </div>
        </div>
        <p class="text-xs text-gray-400 mt-3 italic">
          Entrambe le quote includono materiale didattico, welcome kit, pranzi, cene e attività sociali del programma.
        </p>
      </div>

    </div>

  </div>
</section>

