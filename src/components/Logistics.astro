---
---

<section id="logistics" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-bold text-terracotta uppercase tracking-widest mb-3">
        <span class="w-1.5 h-1.5 bg-terracotta"></span>
        SEZIONE 04 · LOGISTICA &amp; QUOTE
      </div>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-ink uppercase tracking-tight mb-4">
        Alloggio, Mobilità e <span class="text-terracotta">Costi Calmierati</span>
      </h2>
      <p class="font-mono text-xs sm:text-sm text-ink-muted uppercase tracking-wider">
        Una scuola accessibile organizzata da studenti AISF per studenti di fisica.
      </p>
    </div>

    <!-- Logistics Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">

      <!-- Alloggio -->
      <div class="border-[1.5px] border-ink bg-white p-6 shadow-[4px_4px_0px_#16243E] flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 border-[1.5px] border-ink bg-paper flex items-center justify-center mb-4">
            <span class="font-mono font-bold text-terracotta text-sm">H01</span>
          </div>
          <h3 class="font-bold text-ink text-base mb-2">Alloggio Riservato</h3>
          <p class="text-ink-muted text-xs leading-relaxed mb-3">
            <strong>Hotello Padova</strong> – struttura moderna a soli 10 minuti a piedi dalla stazione FS e dalle sedi della scuola, riservata ai partecipanti con opzione con alloggio.
          </p>
        </div>
        <p class="text-[11px] font-mono text-ink-muted pt-3 border-t border-ink/15">
          Opzione senza alloggio disponibile per residenti o organizzati in autonomia.
        </p>
      </div>

      <!-- Spostamenti -->
      <div class="border-[1.5px] border-ink bg-white p-6 shadow-[4px_4px_0px_#16243E] flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 border-[1.5px] border-ink bg-paper flex items-center justify-center mb-4">
            <span class="font-mono font-bold text-ink text-sm">M02</span>
          </div>
          <h3 class="font-bold text-ink text-base mb-2">Spostamenti a Piedi</h3>
          <p class="text-ink-muted text-xs leading-relaxed mb-3">
            Il centro storico di Padova è interamente pedonale e compatto. Per l'escursione scientifica/culturale a Venezia (Mercoledì pomeriggio), i biglietti treno a/r saranno inclusi e coordinati dal comitato.
          </p>
        </div>
        <p class="text-[11px] font-mono text-ink-muted pt-3 border-t border-ink/15">
          Nessun costo o abbonamento di trasporto pubblico urbano necessario.
        </p>
      </div>

      <!-- Vitto e Pasti -->
      <div class="border-[1.5px] border-ink bg-white p-6 shadow-[4px_4px_0px_#16243E] flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 border-[1.5px] border-ink bg-paper flex items-center justify-center mb-4">
            <span class="font-mono font-bold text-crimson text-sm">V03</span>
          </div>
          <h3 class="font-bold text-ink text-base mb-2">Pasti e Coffee Break</h3>
          <p class="text-ink-muted text-xs leading-relaxed mb-3">
            Pranzi e cene sono inclusi nella quota per tutti i partecipanti (sia con che senza alloggio), erogati tramite convenzioni e buoni mensa universitaria ESU.
          </p>
        </div>
        <p class="text-[11px] font-mono text-ink-muted pt-3 border-t border-ink/15">
          Diete vegetariane, vegane e celiache gestite nel modulo di registrazione.
        </p>
      </div>

      <!-- Quote di Partecipazione (Col span 3 editorial display) -->
      <div class="border-[1.5px] border-ink bg-paper p-8 shadow-[5px_5px_0px_#16243E] md:col-span-2 lg:col-span-3">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b-[1.5px] border-ink mb-6">
          <div>
            <span class="font-mono text-xs font-bold text-terracotta uppercase tracking-wider block mb-1">Quota di Iscrizione</span>
            <h3 class="font-display text-3xl sm:text-4xl text-ink">Tariffe Calmierate Studentesche</h3>
          </div>
          <div class="font-mono text-xs text-ink-muted max-w-sm">
            Grazie al sostegno istituzionale e ai contributi AISF, le quote coprono le spese vive di soggiorno e didattica.
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-6">
          <!-- Con Alloggio -->
          <div class="border-[1.5px] border-ink bg-white p-6 shadow-[3px_3px_0px_#16243E] flex flex-col justify-between">
            <div>
              <div class="flex items-baseline justify-between mb-2">
                <span class="font-mono text-xs font-bold uppercase text-terracotta">Formula Completa</span>
                <span class="font-display text-4xl text-ink">120 €</span>
              </div>
              <h4 class="font-bold text-ink text-base mb-2">Quota con Alloggio</h4>
              <ul class="text-xs font-mono text-ink-muted space-y-2 mb-4">
                <li class="flex items-center gap-2">
                  <span class="text-crimson font-bold">✓</span> 4 notti presso Hotello Padova
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-crimson font-bold">✓</span> Tutti i pranzi e cene inclusi (15–19 Marzo)
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-crimson font-bold">✓</span> Kit studente PaThS + Badge ufficiale
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-crimson font-bold">✓</span> Accesso a tutte le lezioni, workshop e uscite
                </li>
              </ul>
            </div>
            <span class="text-[10px] font-mono text-ink-muted block border-t border-ink/10 pt-2">
              Riservata ai 40 partecipanti provenienti da fuori sede.
            </span>
          </div>

          <!-- Senza Alloggio -->
          <div class="border-[1.5px] border-ink bg-white p-6 shadow-[3px_3px_0px_#16243E] flex flex-col justify-between">
            <div>
              <div class="flex items-baseline justify-between mb-2">
                <span class="font-mono text-xs font-bold uppercase text-ink-muted">Formula Days Only</span>
                <span class="font-display text-4xl text-ink">70 €</span>
              </div>
              <h4 class="font-bold text-ink text-base mb-2">Quota senza Alloggio</h4>
              <ul class="text-xs font-mono text-ink-muted space-y-2 mb-4">
                <li class="flex items-center gap-2">
                  <span class="text-crimson font-bold">✓</span> Tutti i pranzi e cene inclusi con il gruppo
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-crimson font-bold">✓</span> Kit studente PaThS + Badge ufficiale
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-crimson font-bold">✓</span> Partecipazione a tutte le lezioni e attività sociali
                </li>
                <li class="flex items-center gap-2 text-ink-muted/60">
                  <span>–</span> Alloggio gestito autonomamente dal partecipante
                </li>
              </ul>
            </div>
            <span class="text-[10px] font-mono text-ink-muted block border-t border-ink/10 pt-2">
              Ideale per studenti UniPD o con alloggio autonomo a Padova.
            </span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
