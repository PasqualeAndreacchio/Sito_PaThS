---
import { eventInfo } from '../data/siteData';
---

<footer id="contact" class="bg-ink-deep text-paper border-t-[1.5px] border-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid md:grid-cols-3 gap-10 mb-12">

      <!-- Brand column -->
      <div>
        <div class="flex items-center gap-3 mb-5">
          <div class="bg-paper p-1.5 border-[1.5px] border-paper shadow-[2px_2px_0px_#9A3324]">
            <img
              src="/images/logo_paths.png"
              alt="PaThS 2027"
              class="h-9 w-auto object-contain"
              width="140"
              height="66"
            />
          </div>
          <div class="w-12 h-12 rounded-full border-[1.5px] border-paper overflow-hidden bg-crimson shadow-[2px_2px_0px_#9A3324] flex-shrink-0">
            <img
              src="/images/logo_aisf_padova.png"
              alt="AISF Padova"
              class="w-full h-full object-cover"
              width="800"
              height="800"
            />
          </div>
        </div>

        <p class="text-paper/70 text-xs font-mono leading-relaxed mb-6">
          Organizzata da {eventInfo.organizer} – {eventInfo.localCommittee}.
        </p>

        <!-- Social buttons: Instagram AISF Padova & PaThS -->
        <div class="flex flex-col gap-2.5">
          <a
            href={eventInfo.instagramAisf}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-4 py-2 border border-paper/30 bg-white/5 hover:bg-terracotta hover:border-paper text-paper text-xs font-mono transition-colors"
          >
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
            </svg>
            <span>Instagram: @aisf_padova</span>
          </a>
          <a
            href={eventInfo.instagramPaths}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-4 py-2 border border-paper/30 bg-white/5 hover:bg-terracotta hover:border-paper text-paper text-xs font-mono transition-colors"
          >
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
            </svg>
            <span>Instagram: @paths2027</span>
          </a>
        </div>
      </div>

      <!-- Quick links -->
      <div>
        <h4 class="text-paper font-mono font-bold text-xs mb-5 uppercase tracking-widest text-terracotta-light">Navigazione</h4>
        <ul class="space-y-2 text-xs font-mono">
          <li><a href="#about" class="scroll-link text-paper/70 hover:text-paper hover:underline">01. L'Iniziativa</a></li>
          <li><a href="#topics" class="scroll-link text-paper/70 hover:text-paper hover:underline">02. Aree Tematiche</a></li>
          <li><a href="#program" class="scroll-link text-paper/70 hover:text-paper hover:underline">03. Programma 5 Giorni</a></li>
          <li><a href="#locations" class="scroll-link text-paper/70 hover:text-paper hover:underline">04. Luoghi a Padova</a></li>
          <li><a href="#logistics" class="scroll-link text-paper/70 hover:text-paper hover:underline">05. Logistica e Quote</a></li>
          <li><a href="#sponsors" class="scroll-link text-paper/70 hover:text-paper hover:underline">06. Sponsor &amp; Partner</a></li>
          <li><a href="#faq" class="scroll-link text-paper/70 hover:text-paper hover:underline">07. FAQ</a></li>
          <li><a href="#register" class="scroll-link text-paper/70 hover:text-paper hover:underline">08. Iscrizione Form</a></li>
        </ul>
      </div>

      <!-- Contacts -->
      <div>
        <h4 class="text-paper font-mono font-bold text-xs mb-5 uppercase tracking-widest text-terracotta-light">Contatti Ufficiali</h4>
        <p class="text-xs font-mono text-paper/70 mb-4 leading-relaxed">
          Per informazioni didattiche, logistiche o domande sul bando di partecipazione:
        </p>
        <ul class="space-y-3 text-xs font-mono">
          <li class="flex items-start gap-2.5">
            <span class="text-terracotta font-bold">@</span>
            <div>
              <p class="text-paper/50 text-[10px]">Email Ufficiale PaThS</p>
              <a href={`mailto:${eventInfo.email}`} class="text-paper hover:underline">
                {eventInfo.email}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-crimson font-bold">🏛</span>
            <div>
              <p class="text-paper/50 text-[10px]">AISF Nazionale</p>
              <a href="https://ai-sf.it" target="_blank" rel="noopener noreferrer" class="text-paper hover:underline">
                ai-sf.it
              </a>
            </div>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom credits -->
    <div class="pt-8 border-t border-paper/15 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] font-mono text-paper/50">
      <p>© 2027 PaThS – Padova Theoretical School · AISF Comitato Locale di Padova</p>
      <p>Organizzato da studenti per studenti · Università degli Studi di Padova</p>
    </div>
  </div>
</footer>
