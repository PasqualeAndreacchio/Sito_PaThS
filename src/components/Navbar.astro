---
import { navLinks, eventInfo } from '../data/siteData';
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-paper/95 backdrop-blur-md border-b-[1.5px] border-ink"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo / Brand with Official PaThS Logo -->
      <a href="#hero" class="flex items-center gap-3 group scroll-link py-1">
        <img
          src="./images/logo_paths.png"
          alt="PaThS Logo"
          class="h-9 sm:h-10 w-auto object-contain transition-transform duration-150 group-hover:scale-105"
          width="160"
          height="75"
        />
        <div class="leading-tight border-l-[1.5px] border-ink/20 pl-2.5 hidden sm:block">
          <span class="font-mono text-xs font-bold text-ink block leading-none">2027</span>
          <span class="text-ink-muted text-[9px] block font-mono uppercase tracking-widest leading-tight">Padova</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <ul class="hidden md:flex items-center gap-6 text-xs font-mono font-bold tracking-wider text-ink uppercase">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="scroll-link py-1 hover:text-terracotta border-b-2 border-transparent hover:border-terracotta transition-colors duration-150"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA + Hamburger -->
      <div class="flex items-center gap-3">
        <a
          href={eventInfo.googleFormUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 bg-crimson text-white text-xs font-mono font-bold px-4 py-2 border-[1.5px] border-ink shadow-[2px_2px_0px_#1B140E] hover:bg-crimson-dark hover:shadow-[3px_3px_0px_#1B140E] transition-all"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15"
            ></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 12H9m9 0l-3-3m3 3l-3 3"></path>
          </svg>
          Iscriviti
        </a>

        <!-- Hamburger button -->
        <button
          id="menu-btn"
          class="md:hidden p-2 border-[1.5px] border-ink text-ink bg-paper hover:bg-paper-warm transition-colors"
          aria-label="Menu"
        >
          <svg id="icon-open" class="w-5 h-5 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden hidden pb-4 border-t-[1.5px] border-ink mt-2 pt-2 bg-paper">
      <ul class="flex flex-col gap-1 text-xs font-mono font-bold uppercase text-ink">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="scroll-link block px-3 py-2 border-b border-ink/10 hover:bg-paper-warm hover:text-terracotta transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-4 px-2">
        <a
          href={eventInfo.googleFormUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="block text-center bg-crimson text-white text-xs font-mono font-bold px-4 py-3 border-[1.5px] border-ink shadow-[2px_2px_0px_#1B140E]"
        >
          Iscriviti Ora (Google Form)
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  menuBtn?.addEventListener('click', () => {
    const isClosed = mobileMenu?.classList.contains('hidden');
    if (isClosed) {
      mobileMenu?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    } else {
      mobileMenu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }
  });

  // Close mobile menu on click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
