---
interface Props {
  variant?: 'loop' | 'wave' | 'double' | 'feynman';
  startLabel?: string;
  endLabel?: string;
  showPoints?: boolean;
  className?: string;
}

const {
  variant = 'loop',
  startLabel = 'P',
  endLabel = 'D',
  showPoints = true,
  className = '',
} = Astro.props;
---

<div class={`w-full overflow-hidden py-6 select-none pointer-events-none flex items-center justify-center ${className}`} aria-hidden="true">
  <div class="w-full max-w-5xl px-4">
    {variant === 'loop' && (
      <!-- Main Path Integral with Loops & Arrows between P and D -->
      <svg
        viewBox="0 0 1000 120"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-auto text-ink opacity-90"
      >
        <defs>
          <marker id="arrow-ink" markerWidth="6" markerHeight="6" refX="4" refY="3" orient="auto">
            <polygon points="0 0, 6 3, 0 6" fill="#1B140E" />
          </marker>
          <marker id="arrow-terracotta" markerWidth="6" markerHeight="6" refX="4" refY="3" orient="auto">
            <polygon points="0 0, 6 3, 0 6" fill="#8C222C" />
          </marker>
        </defs>

        {showPoints && (
          <!-- Point P -->
          <g>
            <circle cx="50" cy="70" r="4.5" fill="#1B140E" />
            <text x="30" y="78" fill="#8C222C" font-family="'Architects Daughter', cursive" font-size="22" font-weight="bold">{startLabel}</text>
          </g>
        )}

        <!-- Upper Trajectory with Quantum Loop & Arrow -->
        <path
          d="M 54 68 C 120 20, 180 15, 230 42 C 265 60, 275 88, 250 95 C 225 100, 215 70, 248 50 C 310 15, 420 25, 520 35 C 620 45, 710 10, 770 28 C 800 36, 810 60, 790 70 C 770 78, 755 58, 785 45 C 840 25, 900 45, 946 68"
          stroke="#1B140E"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <!-- Arrow along upper path -->
        <path
          d="M 370 26 L 382 27 L 374 34"
          fill="none"
          stroke="#1B140E"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M 640 37 L 652 35 L 646 44"
          fill="none"
          stroke="#1B140E"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />

        <!-- Lower Trajectory with Counter-Loop & Directional Fluctuation -->
        <path
          d="M 54 72 C 100 95, 140 105, 180 88 C 205 75, 200 52, 175 55 C 150 58, 160 85, 195 95 C 280 115, 410 85, 500 88 C 610 92, 700 115, 800 95 C 830 88, 845 65, 825 58 C 805 52, 795 72, 820 85 C 865 105, 910 88, 946 72"
          stroke="#1B140E"
          stroke-width="1.4"
          stroke-dasharray="3 2"
          stroke-linecap="round"
        />
        <path
          d="M 460 87 L 472 87 L 466 81"
          fill="none"
          stroke="#1B140E"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />

        {showPoints && (
          <!-- Point D -->
          <g>
            <circle cx="950" cy="70" r="4.5" fill="#1B140E" />
            <text x="965" y="78" fill="#8C222C" font-family="'Architects Daughter', cursive" font-size="22" font-weight="bold">{endLabel}</text>
          </g>
        )}

        <!-- Central Quantum Amplitude label (subtle) -->
        <text
          x="500"
          y="62"
          text-anchor="middle"
          fill="#685548"
          font-family="'Space Mono', monospace"
          font-size="11"
          letter-spacing="0.2em"
          class="uppercase"
        >
          ∫ 𝒟[x(t)] e^(iS/ħ)
        </text>
      </svg>
    )}

    {variant === 'double' && (
      <!-- Double Trajectory Streamer for mid-page transitions -->
      <svg
        viewBox="0 0 1000 60"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-auto text-ink opacity-80"
      >
        <path
          d="M 20 30 C 150 10, 250 50, 360 30 C 430 18, 470 5, 500 25 C 520 40, 500 55, 480 45 C 460 35, 480 15, 520 20 C 650 35, 780 10, 980 30"
          stroke="#1B140E"
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <path
          d="M 280 28 L 292 31 L 283 37"
          fill="none"
          stroke="#1B140E"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M 720 18 L 732 20 L 725 27"
          fill="none"
          stroke="#1B140E"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )}

    {variant === 'wave' && (
      <!-- Subtle wave line with directional arrows -->
      <svg
        viewBox="0 0 1000 40"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-auto text-ink opacity-60"
      >
        <path
          d="M 10 20 C 120 5, 200 35, 320 20 C 440 5, 540 35, 660 20 C 780 5, 870 32, 990 20"
          stroke="#1B140E"
          stroke-width="1.2"
          stroke-dasharray="8 4"
        />
        <circle cx="10" cy="20" r="3" fill="#8C222C" />
        <circle cx="990" cy="20" r="3" fill="#8C222C" />
      </svg>
    )}
  </div>
</div>

