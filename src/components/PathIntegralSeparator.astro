---
interface Props {
  variant?: 'loop' | 'wave' | 'double' | 'feynman';
  startLabel?: string;
  endLabel?: string;
  showPoints?: boolean;
  className?: string;
}

const {
  variant = 'loop',
  startLabel = 'P',
  endLabel = 'D',
  showPoints = true,
  className = '',
} = Astro.props;
---

<div class={`w-full overflow-hidden py-6 select-none pointer-events-none flex items-center justify-center ${className}`} aria-hidden="true">
  <div class="w-full max-w-5xl px-4 sm:px-6">
    <!-- Main Path Integral with Loops & Arrows between P and D -->
    <svg
      viewBox="0 0 1000 120"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-auto text-ink opacity-90"
    >
      <defs>
        <marker id="path-arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M 1 1 L 8 5 L 1 9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="stroke-dasharray: none;" />
        </marker>
      </defs>

      {showPoints && (
        <!-- Point P -->
        <g>
          <circle cx="50" cy="70" r="4.5" fill="#1B140E" />
          <text x="30" y="78" fill="#8C222C" font-family="'Architects Daughter', cursive" font-size="22" font-weight="bold">{startLabel}</text>
        </g>
      )}

      <!-- Upper Trajectory (Continuous line) with Quantum Loop & Tangent Arrow -->
      <path
        d="M 54 68 C 120 20, 180 15, 230 42 C 265 60, 275 88, 250 95 C 225 100, 215 70, 248 50 C 310 15, 410 24, 500 33"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        marker-end="url(#path-arrow)"
      />
      <path
        d="M 500 33 C 590 42, 700 12, 770 28 C 800 36, 810 60, 790 70 C 770 78, 755 58, 785 45 C 840 25, 900 45, 946 68"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <!-- Lower Trajectory (Dashed line) with Counter-Loop & Tangent Arrow -->
      <path
        d="M 54 72 C 100 95, 140 105, 180 88 C 205 75, 200 52, 175 55 C 150 58, 160 85, 195 95 C 280 115, 400 84, 500 88"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-dasharray="3 2"
        stroke-linecap="round"
        marker-end="url(#path-arrow)"
      />
      <path
        d="M 500 88 C 600 92, 700 115, 800 95 C 830 88, 845 65, 825 58 C 805 52, 795 72, 820 85 C 865 105, 910 88, 946 72"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-dasharray="3 2"
        stroke-linecap="round"
      />

      {showPoints && (
        <!-- Point D -->
        <g>
          <circle cx="950" cy="70" r="4.5" fill="#1B140E" />
          <text x="965" y="78" fill="#8C222C" font-family="'Architects Daughter', cursive" font-size="22" font-weight="bold">{endLabel}</text>
        </g>
      )}
    </svg>
  </div>
</div>
