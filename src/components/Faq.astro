---
import { faqList } from '../data/siteData';
---

<section id="faq" class="py-20 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="max-w-3xl mb-14 text-center mx-auto">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-bold text-terracotta uppercase tracking-widest mb-3">
        <span class="w-1.5 h-1.5 bg-terracotta"></span>
        SEZIONE 06 · FAQ
      </div>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-ink uppercase tracking-tight mb-4">
        Domande Frequenti
      </h2>
      <p class="font-mono text-xs sm:text-sm text-ink-muted uppercase tracking-wider">
        Tutto quello che c'è da sapere su requisiti, selezione, alloggi e rimborsi.
      </p>
    </div>

    <!-- FAQ List with crisp editorial border styling -->
    <div class="space-y-4" id="faq-list">
      {faqList.map((faq, idx) => (
        <div class="border-[1.5px] border-ink bg-white shadow-[3px_3px_0px_#16243E] transition-all">
          <button
            class="faq-btn w-full flex justify-between items-center p-5 text-left bg-white hover:bg-paper transition-colors select-none"
            aria-expanded="false"
          >
            <span class="font-bold text-ink text-sm sm:text-base flex items-center gap-3">
              <span class="font-mono text-xs text-terracotta">Q0{idx + 1}.</span>
              {faq.question}
            </span>
            <div class="w-7 h-7 border-[1.5px] border-ink flex items-center justify-center flex-shrink-0 ml-3 bg-paper">
              <svg
                class="faq-icon w-4 h-4 text-ink transition-transform duration-200"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
            </div>
          </button>
          <div class="faq-answer hidden px-5 pb-5 text-xs sm:text-sm text-ink-soft leading-relaxed border-t border-ink/10 pt-3">
            <Fragment set:html={faq.answer} />
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  document.querySelectorAll('.faq-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.border-\\[1\\.5px\\]') || btn.parentElement;
      const answer = item?.querySelector('.faq-answer');
      const icon = btn.querySelector('.faq-icon');

      if (!answer) return;

      const isOpen = !answer.classList.contains('hidden');

      // Close all other open items
      document.querySelectorAll('.faq-answer').forEach((otherAns) => {
        if (otherAns !== answer) {
          otherAns.classList.add('hidden');
          const otherItem = otherAns.parentElement;
          const otherIcon = otherItem?.querySelector('.faq-icon');
          const otherBtn = otherItem?.querySelector('.faq-btn');
          otherIcon?.classList.remove('open');
          otherBtn?.setAttribute('aria-expanded', 'false');
        }
      });

      if (isOpen) {
        answer.classList.add('hidden');
        icon?.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        answer.classList.remove('hidden');
        icon?.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
