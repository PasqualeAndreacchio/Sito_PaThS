<button
  id="back-to-top"
  aria-label="Torna in cima"
  class="fixed bottom-6 right-6 z-40 w-10 h-10 border-[1.5px] border-ink bg-paper text-ink shadow-[3px_3px_0px_#1B140E] flex items-center justify-center opacity-0 pointer-events-none transition-all duration-200 hover:bg-terracotta hover:text-white hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[1px_1px_0px_#1B140E] cursor-pointer"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
  </svg>
</button>

<script>
  const backToTop = document.getElementById('back-to-top');

  if (backToTop) {
    window.addEventListener(
      'scroll',
      () => {
        if (window.scrollY > 400) {
          backToTop.classList.add('visible');
        } else {
          backToTop.classList.remove('visible');
        }
      },
      { passive: true }
    );

    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
