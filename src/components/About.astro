---
import Topics from './Topics.astro';
import PathIntegralSeparator from './PathIntegralSeparator.astro';
import { eventInfo } from '../data/siteData';
---

<section id="about" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-bold text-terracotta uppercase tracking-widest mb-3">
        <span class="w-1.5 h-1.5 bg-terracotta"></span>
        SEZIONE 01 · L'INIZIATIVA
      </div>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-ink uppercase tracking-tight mb-4">
        Una scuola nata per la <span class="text-terracotta">fisica teorica pura</span>
      </h2>
      <p class="font-mono text-xs sm:text-sm text-ink-muted uppercase tracking-wider">
        Tradizione galileiana · Approfondimento specialistico · Dialogo con l'esperimento
      </p>
    </div>

    <!-- Intro Text & Image Grid (Editorial asymmetric composition) -->
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start mb-16">
      
      <!-- Text (7 cols) -->
      <div class="lg:col-span-7 space-y-5 text-ink leading-relaxed">
        <div class="p-6 border-[1.5px] border-ink bg-white shadow-[3px_3px_0px_#16243E]">
          <p class="text-base sm:text-lg text-ink font-normal leading-relaxed">
            L'Associazione Italiana Studenti di Fisica (<strong class="text-terracotta">AISF</strong>) organizza la prima
            edizione della <strong class="text-ink font-bold">Padova Theoretical School (PaThS)</strong>, un evento residenziale dal
            respiro profondamente teorico pensato specificamente per studenti universitari magistrali e triennali avanzati.
          </p>
        </div>

        <p class="text-sm sm:text-base text-ink-soft leading-relaxed">
          L'Università di Padova, con oltre <strong>800 anni di storia accademica</strong>, rappresenta da sempre un punto fermo
          della ricerca scientifica internazionale. PaThS nasce per colmare una lacuna concreta: a fronte di scuole AISF ormai consolidate orientate verso settori applicati e sperimentali, mancava uno spazio interamente consacrato al rigore concettuale e matematico della teoria contemporanea.
        </p>

        <p class="text-sm sm:text-base text-ink-soft leading-relaxed">
          Nonostante la forte vocazione teorica, la scuola manterrà vivo il dialogo costante con la verifica sperimentale e computazionale, valorizzando simulazioni e modelli numerici per la fisica teorica d'avanguardia.
        </p>

        <!-- Academic quote badge -->
        <div class="border-l-4 border-crimson pl-4 py-2 my-4 bg-paper-warm text-ink text-xs sm:text-sm font-mono">
          <em>«La scuola non si limita a riassumere nozioni: crea un percorso unitario tra gravità quantistica, teoria dei campi e materia condensata.»</em>
        </div>
      </div>

      <!-- Image (5 cols, editorial frame) -->
      <div class="lg:col-span-5">
        <div class="border-[1.5px] border-ink bg-white p-3 shadow-[5px_5px_0px_#16243E]">
          <div class="relative overflow-hidden border-[1.5px] border-ink">
            <img
              src="/images/first_image.jpg"
              alt="Fisica teorica – PaThS Padova"
              class="w-full h-80 object-cover object-center filter contrast-[1.05]"
              onerror="this.style.display='none';"
            />
            <div class="absolute bottom-0 inset-x-0 bg-ink/90 text-paper text-[10px] font-mono px-3 py-1 flex justify-between">
              <span>DOCENTI &amp; RICERCATORI</span>
              <span>DFA / INFN / UniPD</span>
            </div>
          </div>
          <div class="pt-3 px-1 flex items-center justify-between text-[11px] font-mono text-ink-muted">
            <span>FIG. 02 — RIGORE E METODO TEORICO</span>
            <span class="text-crimson font-bold">AULA ROSTAGNI</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Modulo Aree Tematiche -->
    <Topics />

    <!-- Trajectory Separator between Topics and Stats -->
    <PathIntegralSeparator variant="loop" startLabel="P" endLabel="D" className="my-6" />

    <!-- Key Metrics & Overview (Editorial Grid instead of generic gradient) -->
    <div class="border-[1.5px] border-ink bg-white p-8 sm:p-10 shadow-[5px_5px_0px_#16243E]">
      <div class="grid sm:grid-cols-3 gap-8 text-left divide-y sm:divide-y-0 sm:divide-x divide-ink/20">
        <div class="sm:pr-6 pt-4 sm:pt-0">
          <span class="font-mono text-xs text-ink-muted uppercase tracking-wider block mb-1">Posti Disponibili</span>
          <div class="font-display text-5xl text-terracotta leading-none mb-2">{eventInfo.participantsCount}</div>
          <p class="text-xs font-mono text-ink leading-relaxed">
            Studenti selezionati da tutta Italia<br />
            <span class="text-ink-muted">{eventInfo.participantsDetail}</span>
          </p>
        </div>

        <div class="sm:px-6 pt-4 sm:pt-0">
          <span class="font-mono text-xs text-ink-muted uppercase tracking-wider block mb-1">Programma Didattico</span>
          <div class="font-display text-5xl text-ink leading-none mb-2">{eventInfo.schoolDays} GIORNI</div>
          <p class="text-xs font-mono text-ink leading-relaxed">
            Lezioni, talks e workshop<br />
            <span class="text-terracotta font-bold">{eventInfo.dates}</span>
          </p>
        </div>

        <div class="sm:pl-6 pt-4 sm:pt-0">
          <span class="font-mono text-xs text-ink-muted uppercase tracking-wider block mb-1">Quote di Partecipazione</span>
          <div class="font-display text-5xl text-crimson leading-none mb-2">{eventInfo.feeAccommodation}</div>
          <p class="text-xs font-mono text-ink leading-relaxed">
            Alloggio + pasti inclusi<br />
            <span class="text-ink-muted">{eventInfo.feeNoAccommodation} (opzione senza alloggio)</span>
          </p>
        </div>
      </div>
    </div>

  </div>
</section>
