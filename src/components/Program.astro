---
import { programDays } from '../data/siteData';

// Background colors for the headers of the 5 days to match original theme
const dayBgColors = [
  'bg-paths-blue',
  'bg-blue-800',
  'bg-blue-700',
  'bg-indigo-700',
  'bg-indigo-900',
];
---

<section id="program" class="py-24 bg-paths-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-16">
      <span class="inline-block text-paths-accent font-mono text-xs font-semibold tracking-widest uppercase mb-3">
        Programma
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-paths-blue mb-4">
        Cinque giorni di fisica teorica
      </h2>
      <div class="w-16 h-1 bg-paths-accent mx-auto rounded-full mb-6"></div>
      <p class="text-gray-500 max-w-2xl mx-auto text-base">
        Un programma scientifico ricco alternato ad attività sociali e culturali nella città di Padova.
      </p>
    </div>

    <!-- Scientific program types -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-16">
      <div class="bg-white rounded-xl p-5 border border-gray-200 shadow-sm">
        <div class="text-paths-accent font-mono text-2xl mb-3">📚</div>
        <h4 class="font-semibold text-paths-blue mb-1 text-sm">Lectures Introduttive</h4>
        <p class="text-gray-500 text-xs leading-relaxed">
          Lezioni di docenti e ricercatori UniPd, INAF, INFN per la descrizione matematica e concettuale dei fenomeni trattati.
        </p>
      </div>
      <div class="bg-white rounded-xl p-5 border border-gray-200 shadow-sm">
        <div class="text-paths-accent font-mono text-2xl mb-3">🔬</div>
        <h4 class="font-semibold text-paths-blue mb-1 text-sm">Research Talks</h4>
        <p class="text-gray-500 text-xs leading-relaxed">
          Seminari di ricerca all'avanguardia tenuti da Professori, Ricercatori Postdoc e studenti di Dottorato.
        </p>
      </div>
      <div class="bg-white rounded-xl p-5 border border-gray-200 shadow-sm">
        <div class="text-paths-accent font-mono text-2xl mb-3">💻</div>
        <h4 class="font-semibold text-paths-blue mb-1 text-sm">Workshop Computazionali</h4>
        <p class="text-gray-500 text-xs leading-relaxed">
          Sessioni pratiche su calcolo teorico avanzato e simulazioni numeriche nella fisica teorica moderna.
        </p>
      </div>
      <div class="bg-white rounded-xl p-5 border border-gray-200 shadow-sm">
        <div class="text-paths-accent font-mono text-2xl mb-3">🗣️</div>
        <h4 class="font-semibold text-paths-blue mb-1 text-sm">Parallel Sessions</h4>
        <p class="text-gray-500 text-xs leading-relaxed">
          Poster session PhD, sessioni parallele proposte dagli stessi partecipanti e Lectio Magistralis.
        </p>
      </div>
    </div>

    <!-- Day-by-day timeline -->
    <div class="space-y-6">
      {programDays.map((day, idx) => (
        <div class="day-card bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
          <div
            class={`day-header flex items-center gap-4 p-5 ${dayBgColors[idx % dayBgColors.length]} cursor-pointer select-none`}
            data-day={day.id}
            role="button"
            tabindex="0"
            aria-expanded={idx === 0 ? "true" : "false"}
          >
            <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0">
              <span class="text-white font-bold font-mono text-sm">{day.dayNumber}</span>
            </div>
            <div class="flex-1">
              <div class="text-blue-200 text-xs font-mono uppercase tracking-widest">{day.dayName}</div>
              <div class="text-white font-bold text-base">{day.title}</div>
            </div>
            <svg
              class={`day-chevron w-5 h-5 text-white/60 transition-transform duration-200 ${idx === 0 ? "open" : ""}`}
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </div>

          <div class={`day-content ${idx === 0 ? "" : "hidden"}`} id={day.id}>
            <div class="p-5 space-y-2">
              {day.schedule.map((item, rowIdx) => (
                <div class={`schedule-row flex gap-3 items-start py-2.5 ${rowIdx < day.schedule.length - 1 ? 'border-b border-gray-100' : ''}`}>
                  <span class="time-badge font-mono text-xs text-paths-accent font-semibold w-28 flex-shrink-0 pt-0.5">
                    {item.time}
                  </span>
                  <div>
                    <p class="text-sm font-medium text-gray-800">{item.title}</p>
                    {item.speakerOrPlace && (
                      <p class="text-xs text-gray-500 mt-0.5">{item.speakerOrPlace}</p>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Pre-school note -->
    <div class="mt-8 bg-blue-50 border border-blue-200 rounded-xl p-6 flex gap-4 items-start">
      <div class="w-8 h-8 rounded-lg bg-paths-accent flex items-center justify-center flex-shrink-0 mt-0.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <p class="text-sm font-semibold text-paths-blue mb-1">Preparazione Pre-Scuola</p>
        <p class="text-sm text-gray-600">
          Prima dell'inizio delle attività verranno pubblicati sul sito i temi trattati, i suggerimenti bibliografici e materiale di approfondimento per preparare al meglio i partecipanti.
        </p>
      </div>
    </div>

  </div>
</section>

<script>
  document.querySelectorAll('.day-header').forEach((header) => {
    const dayId = header.getAttribute('data-day');
    const content = dayId ? document.getElementById(dayId) : null;
    const chevron = header.querySelector('.day-chevron');

    if (!content) return;

    header.addEventListener('click', () => {
      const isHidden = content.classList.contains('hidden');
      if (isHidden) {
        content.classList.remove('hidden');
        chevron?.classList.add('open');
        header.setAttribute('aria-expanded', 'true');
      } else {
        content.classList.add('hidden');
        chevron?.classList.remove('open');
        header.setAttribute('aria-expanded', 'false');
      }
    });

    header.addEventListener('keydown', (e: Event) => {
      const keyEvent = e as KeyboardEvent;
      if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
        keyEvent.preventDefault();
        (header as HTMLElement).click();
      }
    });
  });
</script>

