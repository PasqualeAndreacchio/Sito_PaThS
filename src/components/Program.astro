---
import { programDays } from '../data/siteData';
import PathIntegralSeparator from './PathIntegralSeparator.astro';

// Day header color sequence matching poster palette (Ink, Terracotta, Crimson, Smoke)
const dayHeaderStyles = [
  'bg-ink text-paper border-ink',
  'bg-terracotta text-paper border-ink',
  'bg-crimson text-paper border-ink',
  'bg-smoke-dark text-paper border-ink',
  'bg-ink text-paper border-ink',
];
---

<section id="program" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-bold text-terracotta uppercase tracking-widest mb-3">
        <span class="w-1.5 h-1.5 bg-terracotta"></span>
        SEZIONE 02 · CRONOPROGRAMMA
      </div>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-ink uppercase tracking-tight mb-4">
        Cinque Giorni di <span class="text-terracotta">Scienza e Confronto</span>
      </h2>
      <p class="font-mono text-xs sm:text-sm text-ink-muted uppercase tracking-wider">
        15–19 Marzo 2027 · Palazzo del Monte di Pietà · DFA Rostagni · Palazzo Bo · La Specola
      </p>
    </div>

    <!-- Scientific program types (Editorial Cards based on actual proposal modules) -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-16">
      <div class="editorial-card p-5">
        <div class="font-mono text-xs font-bold text-terracotta uppercase mb-2">MODULO 01</div>
        <h4 class="font-bold text-ink text-base mb-1">Modulo CFT (3 Lezioni)</h4>
        <p class="text-ink-muted text-xs leading-relaxed mb-2">
          Tenuto dal <strong>prof. Roberto Volpato</strong> (UniPD - INFN): fondamenti, simmetria conforme e strumenti analitici.
        </p>
        <span class="text-[10px] font-mono text-terracotta block">Martedì &amp; Mercoledì</span>
      </div>

      <div class="editorial-card p-5">
        <div class="font-mono text-xs font-bold text-crimson uppercase mb-2">MODULO 02</div>
        <h4 class="font-bold text-ink text-base mb-1">Modulo AdS (3 Lezioni)</h4>
        <p class="text-ink-muted text-xs leading-relaxed mb-2">
          Tenuto dal <strong>prof. Stefano Massai</strong> (UniPD): geometria anti-de Sitter, olografia e corrispondenza AdS/CFT.
        </p>
        <span class="text-[10px] font-mono text-crimson block">Martedì &amp; Mercoledì</span>
      </div>

      <div class="editorial-card p-5">
        <div class="font-mono text-xs font-bold text-terracotta uppercase mb-2">MODULO 03</div>
        <h4 class="font-bold text-ink text-base mb-1">Lectio &amp; Research Talks</h4>
        <p class="text-ink-muted text-xs leading-relaxed mb-2">
          Lectio Magistralis del <strong>prof. Gianguido Dall'Agata</strong> (UniPD - INFN), contributo <strong>INAF</strong> e research talks <strong>INFN</strong>.
        </p>
        <span class="text-[10px] font-mono text-terracotta block">Giovedì &amp; Venerdì</span>
      </div>

      <div class="editorial-card p-5">
        <div class="font-mono text-xs font-bold text-ink uppercase mb-2">MODULO 04</div>
        <h4 class="font-bold text-ink text-base mb-1">Workshop &amp; Parallel</h4>
        <p class="text-ink-muted text-xs leading-relaxed mb-2">
          Workshop computazionale alla Specola, Poster Session PhD e sessioni parallele autogestite dai partecipanti.
        </p>
        <span class="text-[10px] font-mono text-ink block">Martedì &amp; Giovedì</span>
      </div>
    </div>

    <!-- Separator -->
    <PathIntegralSeparator variant="wave" className="my-6" />

    <!-- Day-by-day timeline accordion with editorial design -->
    <div class="space-y-4">
      {programDays.map((day, idx) => (
        <div class="border-[1.5px] border-ink bg-white shadow-[4px_4px_0px_#16243E] overflow-hidden">
          <!-- Accordion Header -->
          <div
            class={`day-header flex items-center justify-between gap-4 p-5 ${dayHeaderStyles[idx % dayHeaderStyles.length]} cursor-pointer select-none border-b-[1.5px]`}
            data-day={day.id}
            role="button"
            tabindex="0"
            aria-expanded={idx === 0 ? "true" : "false"}
          >
            <div class="flex items-center gap-4">
              <!-- Day Number stamp -->
              <div class="w-10 h-10 border border-white/40 bg-white/10 flex items-center justify-center font-mono font-bold text-sm">
                0{day.dayNumber}
              </div>
              <div>
                <div class="font-mono text-xs uppercase tracking-widest text-white/80">{day.dayName} · 1{idx + 5} MARZO 2027</div>
                <div class="font-display text-2xl tracking-wide">{day.title}</div>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <span class="font-mono text-xs hidden sm:inline text-white/70">Orari e Sedi</span>
              <svg
                class={`day-chevron w-5 h-5 text-white transition-transform duration-200 ${idx === 0 ? "open" : ""}`}
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>

          <!-- Accordion Content -->
          <div class={`day-content ${idx === 0 ? "" : "hidden"}`} id={day.id}>
            <div class="p-6 bg-paper divide-y divide-ink/15 font-mono">
              {day.schedule.map((item) => (
                <div class="schedule-row flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-6 py-3.5">
                  <!-- Time Slot -->
                  <span class="text-xs font-bold text-terracotta w-36 flex-shrink-0">
                    {item.time}
                  </span>
                  <!-- Activity & Description -->
                  <div class="flex-1">
                    <div class="flex items-center gap-2 flex-wrap mb-0.5">
                      <p class="text-sm font-bold text-ink font-sans">{item.title}</p>
                      {item.tag && (
                        <span class="text-[10px] font-mono px-2 py-0.5 bg-paper-warm border border-ink/20 text-ink font-semibold">
                          {item.tag}
                        </span>
                      )}
                    </div>
                    {item.speaker && (
                      <p class="text-xs text-crimson font-mono mt-1 font-semibold flex items-center gap-1.5">
                        <span class="text-crimson">▸ Docente:</span>
                        <span>{item.speaker}</span>
                      </p>
                    )}
                    {item.location && (
                      <p class="text-[11px] text-ink-muted font-mono mt-0.5 flex items-center gap-1.5">
                        <span class="text-ink">📍 Sede:</span>
                        <span>{item.location}</span>
                      </p>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  document.querySelectorAll('.day-header').forEach((header) => {
    header.addEventListener('click', () => {
      const dayId = header.getAttribute('data-day');
      if (!dayId) return;

      const content = document.getElementById(dayId);
      const chevron = header.querySelector('.day-chevron');
      const isExpanded = header.getAttribute('aria-expanded') === 'true';

      if (isExpanded) {
        content?.classList.add('hidden');
        chevron?.classList.remove('open');
        header.setAttribute('aria-expanded', 'false');
      } else {
        content?.classList.remove('hidden');
        chevron?.classList.add('open');
        header.setAttribute('aria-expanded', 'true');
      }
    });

    header.addEventListener('keydown', (e: any) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        (header as HTMLElement).click();
      }
    });
  });
</script>
