---
import { eventInfo } from '../data/siteData';
---

<section id="register" class="py-20 relative">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <!-- Container with ink border & rich poster aesthetic -->
    <div class="border-[1.5px] border-ink bg-ink text-paper p-8 sm:p-14 shadow-[8px_8px_0px_#9A3324] relative overflow-hidden">

      <!-- Background Feynman trajectory vectors in faint white/terracotta -->
      <div class="absolute inset-0 pointer-events-none opacity-20" aria-hidden="true">
        <svg viewBox="0 0 800 300" fill="none" class="w-full h-full">
          <path
            d="M 20 150 C 150 40, 260 260, 400 120 C 520 20, 600 240, 780 150"
            stroke="#FFFFFF"
            stroke-width="1.5"
            stroke-dasharray="6 4"
          />
          <circle cx="20" cy="150" r="4" fill="#9A3324" />
          <circle cx="780" cy="150" r="4" fill="#9A3324" />
        </svg>
      </div>

      <div class="relative z-10 text-center max-w-2xl mx-auto">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 border border-paper/40 bg-white/10 px-3 py-1 font-mono text-xs uppercase tracking-widest text-paper mb-6">
          <span class="w-2 h-2 rounded-full bg-crimson animate-pulse"></span>
          Candidature Aperte · 48 Posti Totali
        </div>

        <!-- Heading with Bebas Neue -->
        <h2 class="font-display text-4xl sm:text-6xl lg:text-7xl text-paper uppercase tracking-tight mb-4 leading-none">
          Unisciti alla prima edizione di <span class="text-terracotta-light">PaThS 2027</span>
        </h2>

        <p class="font-mono text-xs sm:text-sm text-paper/80 mb-8 leading-relaxed">
          Padova, {eventInfo.dates} · Cinque giorni immersi nella fisica teorica pura con docenti UniPD, INFN e ricercatori internazionali.
        </p>

        <!-- CTA Button -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={eventInfo.googleFormUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-terracotta text-paper font-mono font-bold text-sm uppercase px-8 py-4 border-[1.5px] border-paper shadow-[4px_4px_0px_#FFFFFF] hover:bg-terracotta-dark hover:translate-x-0.5 hover:translate-y-0.5 transition-all"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l3 3m0 0l-3 3m3-3H9"
              ></path>
            </svg>
            Iscriviti Ora (Google Form)
          </a>
        </div>

        <p class="font-mono text-[11px] text-paper/60 mt-4">
          Le domande saranno valutate in ordine cronologico e di merito dal comitato scientifico.
        </p>
      </div>

    </div>

  </div>
</section>
