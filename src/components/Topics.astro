---
import { featuredTopic, generalTopics } from '../data/siteData';
---

<div id="topics" class="mb-16">
  <!-- Section Title -->
  <div class="border-b-[1.5px] border-ink pb-3 mb-8">
    <h3 class="font-display text-3xl sm:text-4xl text-ink uppercase tracking-tight">
      Aree Tematiche &amp; Discipline Fondamentali
    </h3>
  </div>

  <!-- Card in primo piano: Tema Principale (AdS/CFT e Olografia) -->
  <div class="mb-8">
    <div
      class="border-[1.5px] border-ink bg-white p-6 sm:p-8 shadow-[5px_5px_0px_#1B140E] transition-transform duration-200 hover:-translate-y-0.5"
    >
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="flex items-start gap-5">
          <!-- Symbol Box in Terracotta / Ink -->
          <div
            class="w-14 h-14 bg-paper-warm border-[1.5px] border-ink flex items-center justify-center flex-shrink-0 shadow-[2px_2px_0px_#1B140E]"
          >
            <span class="text-terracotta font-bold font-mono text-2xl">{featuredTopic.symbol}</span>
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="font-mono text-xs font-bold uppercase tracking-wider bg-crimson text-white px-2 py-0.5">
                Focus Edizione 2027
              </span>
              <h4 class="font-display text-2xl sm:text-3xl text-ink tracking-wide">
                {featuredTopic.title}
              </h4>
            </div>
            <p class="text-ink text-sm sm:text-base leading-relaxed mb-4 max-w-3xl">
              {featuredTopic.description}
            </p>
            {featuredTopic.link && (
              <a
                href={featuredTopic.link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-xs font-mono font-bold text-ink uppercase border-[1.5px] border-ink px-3 py-1.5 bg-paper hover:bg-terracotta hover:text-white transition-colors"
              >
                <span>{featuredTopic.linkText || "Approfondimento AdS/CFT"}</span>
                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
          </div>
        </div>

        {featuredTopic.pill && (
          <div class="hidden lg:flex items-center self-center flex-shrink-0">
            <div class="font-mono text-xs font-bold text-terracotta bg-terracotta-wash border-[1.5px] border-terracotta px-4 py-2 text-center">
              <span>{featuredTopic.pill}</span>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Aree tematiche secondarie (Editorial Asymmetric Grid) -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {generalTopics.map((topic) => (
      <div class="border-[1.5px] border-ink bg-white p-6 shadow-[3px_3px_0px_#1B140E] hover:-translate-y-0.5 hover:shadow-[5px_5px_0px_#1B140E] transition-all flex flex-col justify-between">
        <div>
          <h4 class="font-bold text-ink text-base mb-3">{topic.title}</h4>
          <p class="text-ink-soft text-xs sm:text-sm leading-relaxed">{topic.description}</p>
        </div>
      </div>
    ))}
  </div>
</div>
