---
import { locationsList } from '../data/siteData';
import PathIntegralSeparator from './PathIntegralSeparator.astro';
---

<section id="locations" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-bold text-terracotta uppercase tracking-widest mb-3">
        <span class="w-1.5 h-1.5 bg-terracotta"></span>
        SEZIONE 03 · I LUOGHI
      </div>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-ink uppercase tracking-tight mb-4">
        Spazi Storici e <span class="text-terracotta">Accademici a Padova</span>
      </h2>
      <p class="font-mono text-xs sm:text-sm text-ink-muted uppercase tracking-wider">
        Tutte le aule e le strutture sono nel centro storico di Padova, collegate a piedi in pochi minuti.
      </p>
    </div>

    <!-- Locations Grid (Editorial cards with ink border, 3x2 grid) -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {locationsList.map((loc, idx) => (
        <div class="border-[1.5px] border-ink bg-white shadow-[4px_4px_0px_#1B140E] hover:-translate-y-0.5 hover:shadow-[6px_6px_0px_#1B140E] transition-all flex flex-col justify-between">
          <div>
            <!-- Image with ink frame: Distinguish Logo vs Photo -->
            {loc.isLogo ? (
              <div class="relative h-48 w-full border-b-[1.5px] border-ink bg-[#FAF9F6] flex items-center justify-center p-8 sm:p-10 overflow-hidden">
                <img
                  src={loc.image}
                  alt={loc.alt}
                  class="max-h-20 max-w-[70%] w-auto h-auto object-contain mix-blend-multiply transition-transform duration-300 hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute top-2 left-2 bg-crimson text-white text-[10px] font-mono font-bold px-2 py-0.5 uppercase tracking-wider border border-white/30 z-10 shadow-sm pointer-events-none">
                  {loc.badge}
                </div>
                <div class="absolute bottom-2 right-2 bg-ink text-paper text-[10px] font-mono px-2 py-0.5 z-10 pointer-events-none">
                  0{idx + 1}
                </div>
              </div>
            ) : (
              <div class="relative h-48 w-full border-b-[1.5px] border-ink bg-paper-warm overflow-hidden">
                <img
                  src={loc.image}
                  alt={loc.alt}
                  class="w-full h-full object-cover object-center filter contrast-[1.04] transition-transform duration-500 hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute top-2 left-2 bg-crimson text-white text-[10px] font-mono font-bold px-2 py-0.5 uppercase tracking-wider border border-white/30 z-10 shadow-sm pointer-events-none">
                  {loc.badge}
                </div>
                <div class="absolute bottom-2 right-2 bg-ink text-paper text-[10px] font-mono px-2 py-0.5 z-10 pointer-events-none">
                  0{idx + 1}
                </div>
              </div>
            )}

            <!-- Content -->
            <div class="p-5">
              <h3 class="font-bold text-ink text-base mb-2 font-sans">
                {loc.title}
              </h3>
              <p class="text-ink-muted text-xs leading-relaxed mb-4">
                {loc.description}
              </p>
            </div>
          </div>

          <!-- Address & Maps link -->
          <div class="p-5 pt-0 border-t border-ink/15 mt-2">
            <p class="text-[11px] font-mono text-ink-muted mb-3 flex items-start gap-1.5 pt-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-3.5 h-3.5 text-terracotta flex-shrink-0 mt-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>{loc.address}</span>
            </p>
            <a
              href={loc.mapLink}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-1.5 bg-paper text-ink border-[1.5px] border-ink py-2 px-3 text-xs font-mono font-bold uppercase hover:bg-ink hover:text-white transition-colors"
            >
              <span>Mappa Interattiva</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Mobility Footnote Banner (Editorial Style) -->
    <div class="border-[1.5px] border-ink bg-white p-5 shadow-[3px_3px_0px_#1B140E] flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 border-[1.5px] border-ink bg-terracotta-wash text-terracotta flex items-center justify-center font-mono font-bold text-lg flex-shrink-0">
          🚶
        </div>
        <div>
          <p class="font-bold text-ink text-sm font-sans">Spostamenti Pedonali &amp; Prossimità</p>
          <p class="text-xs text-ink-muted font-mono">
            Tutte le distanze tra Hotello, Palazzo del Monte di Pietà, l'Aula Rostagni DFA e Palazzo Bo si percorrono a piedi in 5–15 minuti.
          </p>
        </div>
      </div>
      <a
        href="#logistics"
        class="scroll-link font-mono text-xs font-bold text-terracotta hover:text-ink underline whitespace-nowrap"
      >
        Dettagli logistici e alloggio →
      </a>
    </div>

    <PathIntegralSeparator variant="wave" className="my-6" />

  </div>
</section>
