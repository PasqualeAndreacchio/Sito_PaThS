---
import { eventInfo } from '../data/siteData';
---

<section id="hero" class="relative min-h-[92vh] flex items-center justify-center pt-24 pb-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto w-full">

    <!-- Top bar: Institutional Badges directly mirroring the poster -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
      <!-- Left: AISF National institutional box (just like top-left of the poster) -->
      <div class="inline-flex items-center gap-3 bg-white border-[1.5px] border-ink px-4 py-2 shadow-[2px_2px_0px_#16243E]">
        <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-blue-700 via-indigo-500 to-rose-400 flex items-center justify-center text-white text-[10px] font-bold font-mono">
          Ψ
        </div>
        <div class="leading-tight">
          <span class="font-black text-ink tracking-wider text-xs block font-mono">A I S F</span>
          <span class="text-[9px] text-ink-muted uppercase tracking-tight block">Associazione Italiana Studenti di Fisica</span>
        </div>
      </div>

      <!-- Right: UniPD & Local Committee coordinate badge -->
      <div class="inline-flex items-center gap-2 text-xs font-mono text-ink-muted border-[1.5px] border-ink/30 px-3 py-1.5 bg-paper-warm">
        <span class="w-2 h-2 rounded-full bg-crimson animate-pulse"></span>
        <span class="font-bold text-ink">UniPD · Comitato Locale di Padova</span>
        <span class="text-ink-muted hidden sm:inline">| 45.4064° N, 11.8768° E</span>
      </div>
    </div>

    <!-- Central Hero Composition: The Path Integral Identity & Editorial Content -->
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">

      <!-- Left Column: The Path Integral Logo & Core Information (7 cols) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">

        <!-- ============================================================
             OFFICIAL "PATHS" PATH INTEGRAL LOGO (VECTOR RECREATION)
             Feynman path integral from point P to point D with loops & arrows
             ============================================================ -->
        <div class="w-full max-w-xl my-2 select-none">
          <svg
            viewBox="0 0 620 220"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="w-full h-auto drop-shadow-sm"
          >
            <!-- Point P (Left) -->
            <g>
              <circle cx="28" cy="148" r="5" fill="#16243E" />
              <text x="6" y="166" fill="#9A3324" font-family="'Architects Daughter', cursive" font-size="34" font-weight="bold">P</text>
            </g>

            <!-- Point D (Right - Padova) -->
            <g>
              <circle cx="580" cy="108" r="5" fill="#16243E" />
              <text x="592" y="122" fill="#9A3324" font-family="'Architects Daughter', cursive" font-size="34" font-weight="bold">D</text>
            </g>

            <!-- Upper Feynman Trajectory with Loop & Arrow -->
            <!-- From P (28, 148) -> rises -> loop on top-left -> arc over letters -> loop on top-right -> D (580, 108) -->
            <path
              d="M 32 146 C 70 85, 110 50, 150 72 C 175 88, 175 118, 150 118 C 128 118, 130 85, 165 65 C 235 25, 340 18, 440 38 C 490 48, 520 25, 540 45 C 555 60, 545 85, 525 80 C 505 75, 510 52, 532 58 C 555 65, 570 90, 576 106"
              stroke="#16243E"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <!-- Directional arrow on upper trajectory -->
            <path
              d="M 125 90 L 136 78 L 138 94"
              fill="none"
              stroke="#16243E"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M 445 40 L 458 42 L 450 52"
              fill="none"
              stroke="#16243E"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />

            <!-- Lower Feynman Trajectory with Loop & Arrow under text -->
            <!-- From P (28, 148) -> dips down -> loop bottom-left -> curve under subtitle -> loop bottom-right -> D (580, 108) -->
            <path
              d="M 32 150 C 65 175, 100 185, 125 165 C 145 150, 140 130, 120 135 C 100 140, 105 168, 135 180 C 220 205, 360 198, 470 170 C 510 160, 535 175, 520 190 C 505 200, 485 188, 500 172 C 520 150, 555 125, 576 110"
              stroke="#16243E"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <!-- Directional arrow on lower trajectory -->
            <path
              d="M 80 168 L 94 165 L 88 178"
              fill="none"
              stroke="#16243E"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M 488 165 L 502 160 L 498 174"
              fill="none"
              stroke="#16243E"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />

            <!-- MAIN DISPLAY WORD "PATHS" in Rich Terracotta Red (#9A3324) -->
            <text
              x="300"
              y="126"
              fill="#9A3324"
              font-family="'Bebas Neue', Impact, sans-serif"
              font-size="94"
              font-weight="900"
              letter-spacing="0.08em"
              text-anchor="middle"
              style="transform: rotate(-3deg); transform-origin: 300px 126px;"
            >
              PATHS
            </text>

            <!-- SUBTITLE "PADOVA THEORETICAL SCHOOL" in Ink Navy (#16243E) with hand physics style -->
            <text
              x="306"
              y="155"
              fill="#16243E"
              font-family="'Architects Daughter', cursive"
              font-size="16"
              font-weight="bold"
              letter-spacing="0.22em"
              text-anchor="middle"
              style="transform: rotate(-2deg); transform-origin: 306px 155px;"
            >
              PADOVA THEORETICAL SCHOOL
            </text>
          </svg>
        </div>

        <!-- Edition & Dates Lead Line -->
        <div class="flex items-center gap-2 mb-4 mt-2">
          <span class="bg-crimson text-white font-mono text-xs font-bold px-2.5 py-1 tracking-wider uppercase">
            {eventInfo.edition}
          </span>
          <span class="text-terracotta font-mono font-bold text-sm tracking-wide">
            {eventInfo.dates} · {eventInfo.city}
          </span>
        </div>

        <!-- Tagline / Manifest description -->
        <p class="text-ink text-lg sm:text-xl font-normal leading-relaxed mb-6 max-w-xl">
          La prima scuola residenziale italiana dedicata alla <strong>fisica teorica pura</strong>: dall'olografia AdS/CFT
          alle teorie di gauge, dall'informazione quantistica alla materia condensata.
        </p>

        <!-- Technical Parameters List (Editorial Grid) -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 w-full mb-8 font-mono text-xs text-ink">
          <div class="border-[1.5px] border-ink p-2.5 bg-paper">
            <span class="text-ink-muted block text-[10px] uppercase">Posti</span>
            <span class="font-bold text-sm text-terracotta">{eventInfo.participantsCount}</span>
            <span class="text-[10px] text-ink-muted block">40 Nazionali + 8 UniPD</span>
          </div>
          <div class="border-[1.5px] border-ink p-2.5 bg-paper">
            <span class="text-ink-muted block text-[10px] uppercase">Durata</span>
            <span class="font-bold text-sm text-ink">{eventInfo.schoolDays} Giorni</span>
            <span class="text-[10px] text-ink-muted block">Full immersion</span>
          </div>
          <div class="border-[1.5px] border-ink p-2.5 bg-paper col-span-2 sm:col-span-1">
            <span class="text-ink-muted block text-[10px] uppercase">Focus 2027</span>
            <span class="font-bold text-sm text-crimson">AdS/CFT</span>
            <span class="text-[10px] text-ink-muted block">&amp; Olografia</span>
          </div>
        </div>

        <!-- PRIMARY CALL TO ACTION (Feedback IT Lead: Solo "Iscriviti Ora", nessun "Scopri di più") -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto">
          <a
            href={eventInfo.googleFormUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary text-center justify-center text-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l3 3m0 0l-3 3m3-3H9" />
            </svg>
            Iscriviti Ora (Google Form)
          </a>

          <span class="text-xs text-ink-muted font-mono self-center">
            Scadenza candidature: <strong>Posti limitati</strong>
          </span>
        </div>

      </div>

      <!-- Right Column: Asymmetric Editorial Image & Official Poster Seal (5 cols) -->
      <div class="lg:col-span-5 relative">

        <!-- Outer Editorial Frame -->
        <div class="relative bg-white border-[1.5px] border-ink p-3 shadow-[6px_6px_0px_#16243E]">
          <!-- Real Local Photo of Padua -->
          <div class="relative overflow-hidden border-[1.5px] border-ink bg-paper-warm">
            <img
              src="/images/padova.jpg"
              alt="Padova – Sede della Theoretical School 2027"
              class="w-full h-80 sm:h-96 object-cover object-center filter contrast-[1.05]"
            />
            <!-- Architectural coordinate label -->
            <div class="absolute bottom-0 inset-x-0 bg-ink text-paper px-3 py-1.5 flex justify-between items-center text-[10px] font-mono">
              <span>PADOVA · CULLA DELLA FISICA TEORICA</span>
              <span>1222–2027</span>
            </div>
          </div>

          <!-- Exhibition caption under image -->
          <div class="pt-3 pb-1 px-1 flex items-start justify-between text-[11px] font-mono text-ink-muted">
            <div>
              <p class="font-bold text-ink">FIG. 01 — IL TEATRO DELLA SCUOLA</p>
              <p class="text-[10px]">Palazzo del Monte di Pietà · Aula Rostagni DFA · Palazzo Bo · La Specola</p>
            </div>
            <span class="text-terracotta font-bold">PaThS 2027</span>
          </div>

          <!-- ============================================================
               OFFICIAL "AISF PADOVA" CIRCULAR SEAL BADGE (FROM POSTER)
               UniPD Crimson (#990012) round seal with La Specola tower silhouette
               ============================================================ -->
          <div
            class="absolute -bottom-7 -left-7 w-28 h-28 rounded-full bg-crimson border-2 border-white text-white flex flex-col items-center justify-center text-center p-2 shadow-[4px_4px_0px_#16243E] select-none"
            aria-label="AISF Padova"
          >
            <!-- Specola Tower Icon -->
            <svg viewBox="0 0 40 40" fill="none" class="w-8 h-8 mb-0.5">
              <!-- La Specola stylized silhouette -->
              <rect x="16" y="10" width="8" height="18" fill="white" />
              <polygon points="20,4 14,10 26,10" fill="white" />
              <rect x="18" y="14" width="4" height="4" fill="#990012" />
              <rect x="13" y="28" width="14" height="5" fill="white" />
            </svg>
            <span class="font-bold font-serif text-sm tracking-widest leading-none">AISF</span>
            <span class="text-[8px] font-mono tracking-widest uppercase text-white/90 leading-tight">PADOVA</span>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
