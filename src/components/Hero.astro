---
import { eventInfo } from '../data/siteData';
---

<section id="hero" class="relative min-h-[92vh] flex items-center justify-center pt-24 pb-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto w-full">

    <!-- Central Hero Composition: The Path Integral Identity & Editorial Content -->
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">

      <!-- Left Column: The Official PaThS Logo & Core Information (7 cols) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">

        <!-- ============================================================
             OFFICIAL "PATHS" LOGO (Feynman path integral from P to D)
             ============================================================ -->
        <div class="w-full max-w-lg lg:max-w-xl my-2 select-none">
          <img
            src="./images/logo_paths.png"
            alt="PaThS – Padova Theoretical Physics School"
            class="w-full h-auto object-contain filter drop-shadow-sm"
            width="1600"
            height="751"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <!-- Edition & Dates Lead Line -->
        <div class="flex items-center gap-2 mb-4 mt-2">
          <span class="bg-crimson text-white font-mono text-xs font-bold px-2.5 py-1 tracking-wider uppercase">
            {eventInfo.edition}
          </span>
          <span class="text-terracotta font-mono font-bold text-sm tracking-wide">
            {eventInfo.dates} · {eventInfo.city}
          </span>
        </div>

        <!-- Tagline / Manifest description -->
        <p class="text-ink text-lg sm:text-xl font-normal leading-relaxed mb-6 max-w-xl">
          La prima scuola AISF dedicata alla <strong>fisica teorica pura</strong>: dall'olografia AdS/CFT
          alle teorie di gauge, dall'informazione quantistica alla materia condensata.
        </p>

        <!-- Technical Parameters List (Editorial Grid) -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 w-full mb-8 font-mono text-xs text-ink">
          <div class="border-[1.5px] border-ink p-2.5 bg-paper">
            <span class="text-ink-muted block text-[10px] uppercase">Posti</span>
            <span class="font-bold text-sm text-terracotta">{eventInfo.participantsCount}</span>
            <span class="text-[10px] text-ink-muted block">40 Nazionali + 8 UniPD</span>
          </div>
          <div class="border-[1.5px] border-ink p-2.5 bg-paper">
            <span class="text-ink-muted block text-[10px] uppercase">Durata</span>
            <span class="font-bold text-sm text-ink">{eventInfo.schoolDays} Giorni</span>
            <span class="text-[10px] text-ink-muted block">Full immersion</span>
          </div>
          <div class="border-[1.5px] border-ink p-2.5 bg-paper col-span-2 sm:col-span-1">
            <span class="text-ink-muted block text-[10px] uppercase">Focus 2027</span>
            <span class="font-bold text-sm text-crimson">AdS/CFT</span>
            <span class="text-[10px] text-ink-muted block">&amp; Olografia</span>
          </div>
        </div>

        <!-- PRIMARY CALL TO ACTION (Solo "Iscriviti Ora") -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto">
          <a
            href={eventInfo.googleFormUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary text-center justify-center text-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l3 3m0 0l-3 3m3-3H9" />
            </svg>
            Iscriviti Ora (Google Form)
          </a>

          <span class="text-xs text-ink-muted font-mono self-center">
            Scadenza candidature: <strong>Posti limitati</strong>
          </span>
        </div>

      </div>

      <!-- Right Column: Asymmetric Editorial Image & Official Poster Seal (5 cols) -->
      <div class="lg:col-span-5 relative">

        <!-- Outer Editorial Frame -->
        <div class="relative bg-white border-[1.5px] border-ink p-3 shadow-[6px_6px_0px_#1B140E]">
          <!-- ============================================================
               OFFICIAL "AISF PADOVA" CIRCULAR SEAL BADGE (TOP-RIGHT CORNER)
               Cleanly positioned to eliminate collisions with text and bottom bar
               ============================================================ -->
          <div
            class="absolute -top-6 -right-6 sm:-top-7 sm:-right-7 w-24 sm:w-28 h-24 sm:h-28 rounded-full border-2 border-white shadow-[4px_4px_0px_#1B140E] overflow-hidden select-none bg-crimson transition-transform hover:scale-105 duration-200 z-10"
            aria-label="AISF Padova"
          >
            <img
              src="./images/logo_aisf_padova.png"
              alt="AISF Padova – Comitato Locale"
              class="w-full h-full object-cover rounded-full"
              width="800"
              height="800"
              loading="eager"
            />
          </div>

          <!-- Real Local Photo of Padua with elegant muted editorial filter -->
          <div class="relative overflow-hidden border-[1.5px] border-ink bg-paper-warm">
            <img
              src="./images/padova.jpg"
              alt="Padova – Sede della Theoretical School 2027"
              class="w-full h-80 sm:h-96 object-cover object-center filter contrast-[1.02] saturate-[0.85] brightness-[0.98]"
            />
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
