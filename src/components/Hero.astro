---
import { eventInfo } from '../data/siteData';
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background image with overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/padova.jpg"
      alt="Padova – Panorama"
      class="w-full h-full object-cover object-center"
      onerror="this.style.display='none'"
    />
    <!-- Dark gradient overlay -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(135deg, rgba(10,25,47,0.88) 0%, rgba(26,58,92,0.82) 50%, rgba(15,30,70,0.90) 100%);"
    ></div>
    <!-- Subtle dot-grid pattern -->
    <div
      class="absolute inset-0 opacity-10"
      style="background-image: radial-gradient(circle, rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 32px 32px;"
    ></div>
  </div>

  <!-- Hero content -->
  <div class="relative z-10 text-center text-white px-4 sm:px-6 max-w-5xl mx-auto pt-24 pb-16">
    <!-- AISF badge -->
    <div
      class="inline-flex items-center gap-2 bg-white/10 border border-white/20 backdrop-blur-sm text-white/90 text-xs font-semibold px-4 py-1.5 rounded-full mb-8 tracking-wide uppercase"
    >
      <span class="w-2 h-2 rounded-full bg-blue-300 animate-pulse"></span>
      {eventInfo.organizer} – {eventInfo.localCommittee}
    </div>

    <!-- Main title -->
    <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-none mb-4 hero-title">
      <span class="text-white">PaThS</span>
      <span class="text-blue-300"> {eventInfo.edition}</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-blue-200 font-mono text-sm sm:text-base font-semibold tracking-widest uppercase mb-6 hero-subtitle">
      {eventInfo.subtitle}
    </p>

    <!-- Tagline -->
    <p class="text-white/85 text-lg sm:text-xl lg:text-2xl font-light leading-relaxed max-w-3xl mx-auto mb-10">
      La prima scuola italiana dedicata alla fisica teorica contemporanea: dalle stringhe alla materia condensata,
      dall'informazione quantistica alle interazioni fondamentali.
    </p>

    <!-- Event info pills -->
    <div class="flex flex-wrap justify-center gap-3 mb-10 text-sm font-medium">
      <div class="flex items-center gap-2 bg-white/10 border border-white/20 px-4 py-2 rounded-full backdrop-blur-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>{eventInfo.dates}</span>
      </div>
      <div class="flex items-center gap-2 bg-white/10 border border-white/20 px-4 py-2 rounded-full backdrop-blur-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>{eventInfo.city}</span>
      </div>
      <div class="flex items-center gap-2 bg-white/10 border border-white/20 px-4 py-2 rounded-full backdrop-blur-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>{eventInfo.participantsCount} partecipanti da tutta Italia</span>
      </div>
    </div>

    <!-- CTA Buttons -->
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="#register"
        class="scroll-link inline-flex items-center gap-2 bg-paths-accent text-white font-bold text-base px-8 py-3.5 rounded-xl hover:bg-blue-500 transition-all duration-200 shadow-lg shadow-blue-700/40 hover:shadow-blue-500/50 hover:-translate-y-0.5"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l3 3m0 0l-3 3m3-3H9" />
        </svg>
        Iscriviti Ora
      </a>
      <a
        href="#about"
        class="scroll-link inline-flex items-center gap-2 bg-white/10 border border-white/30 text-white font-semibold text-base px-8 py-3.5 rounded-xl hover:bg-white/20 transition-all duration-200 backdrop-blur-sm"
      >
        Scopri di più
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>

