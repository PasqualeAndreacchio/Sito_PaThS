---
import { eventInfo } from '../data/siteData';

const patrocini = [
  "Università di Padova",
  "Dip. Fisica e Astronomia",
  "INFN – Sez. Padova",
  "INAF – Sez. Padova",
  "Comune di Padova",
];
---

<section id="sponsors" class="py-24 bg-paths-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-16">
      <span class="inline-block text-paths-accent font-mono text-xs font-semibold tracking-widest uppercase mb-3">
        Sponsor &amp; Partner
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-paths-blue mb-4">
        Istituzioni e Partner
      </h2>
      <div class="w-16 h-1 bg-paths-accent mx-auto rounded-full mb-6"></div>
      <p class="text-gray-500 max-w-2xl mx-auto text-base">
        PaThS è realizzata con il supporto di università, enti di ricerca e realtà che credono nella formazione scientifica dei giovani fisici italiani.
      </p>
    </div>

    <!-- Patrocini -->
    <div class="mb-10">
      <p class="text-center text-xs font-semibold text-gray-400 uppercase tracking-widest mb-6">
        Patrocini &amp; Enti Istituzionali
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        {patrocini.map((patrocinio) => (
          <div class="sponsor-slot bg-white rounded-xl border-2 border-dashed border-gray-200 p-5 flex flex-col items-center justify-center gap-2 min-h-[100px] hover:border-paths-accent transition-colors group">
            <div class="w-12 h-12 rounded-lg bg-gray-100 group-hover:bg-blue-50 flex items-center justify-center transition-colors">
              <svg class="w-6 h-6 text-gray-300 group-hover:text-paths-accent transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
              </svg>
            </div>
            <span class="text-xs text-gray-400 text-center leading-tight">{patrocinio}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Sponsor row -->
    <div>
      <p class="text-center text-xs font-semibold text-gray-400 uppercase tracking-widest mb-6">Sponsor</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {[1, 2, 3, 4].map(() => (
          <div class="sponsor-slot bg-white rounded-xl border-2 border-dashed border-gray-200 p-5 flex flex-col items-center justify-center gap-2 min-h-[80px] hover:border-paths-gold transition-colors group">
            <span class="text-xs text-gray-300 text-center italic">Logo sponsor</span>
          </div>
        ))}
      </div>
      <p class="text-center text-xs text-gray-400 mt-6">
        Sei interessato a sponsorizzare PaThS?
        <a href={`mailto:${eventInfo.email}`} class="text-paths-accent font-medium hover:underline ml-1">
          Contattaci →
        </a>
      </p>
    </div>

  </div>
</section>

