---
import { eventInfo } from '../data/siteData';

const patrocini = [
  "Università degli Studi di Padova",
  "Dipartimento di Fisica e Astronomia",
  "INFN – Sezione di Padova",
  "INAF – Osservatorio Astronomico",
  "Comune di Padova",
];
---

<section id="sponsors" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-bold text-terracotta uppercase tracking-widest mb-3">
        <span class="w-1.5 h-1.5 bg-terracotta"></span>
        SEZIONE 05 · PATROCINI &amp; SPONSOR
      </div>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-ink uppercase tracking-tight mb-4">
        Istituzioni e <span class="text-terracotta">Partner Accademici</span>
      </h2>
      <p class="font-mono text-xs sm:text-sm text-ink-muted uppercase tracking-wider">
        Enti scientifici e istituzionali a sostegno della formazione teorica delle giovani generazioni.
      </p>
    </div>

    <!-- Patrocini Istituzionali -->
    <div class="mb-12">
      <div class="font-mono text-xs font-bold text-ink uppercase tracking-widest mb-4 flex items-center gap-2">
        <span class="w-2 h-2 bg-crimson"></span>
        Patrocini e Collaborazioni Scientifiche
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        {patrocini.map((patrocinio) => (
          <div class="border-[1.5px] border-ink bg-white p-5 flex flex-col items-center justify-center text-center min-h-[120px] shadow-[3px_3px_0px_#1B140E] hover:-translate-y-0.5 transition-all">
            <div class="w-9 h-9 border-[1.5px] border-ink bg-paper flex items-center justify-center font-mono font-bold text-xs text-ink mb-2">
              Uni
            </div>
            <span class="text-xs font-bold text-ink leading-tight font-sans">{patrocinio}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
