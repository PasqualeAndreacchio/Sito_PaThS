---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "PaThS 2027 – Padova Theoretical School",
  description = "Prima edizione della Padova Theoretical School (PaThS), organizzata dall'AISF Comitato Locale di Padova. 15-19 Marzo 2027, Università di Padova.",
  image = "./images/logo_paths.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://pasqualeandreacchio.github.io/Sito_PaThS/");
const ogImageURL = new URL(image, canonicalURL).href;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="it_IT" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Google Fonts: Bebas Neue, Architects Daughter, Plus Jakarta Sans, Space Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Bebas+Neue&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-paper text-ink antialiased selection:bg-crimson selection:text-white relative min-h-screen">
    
    <!-- ============================================================
         WATERCOLOR ATMOSPHERE LAYERS (OFFICIAL EVENT PALETTE)
         Hidden on mobile for uniform, high-contrast text rendering.
         Visible on desktop as a subtle atmospheric backdrop.
         ============================================================ -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
      <div class="hidden md:block w-full h-full relative">
        <!-- Top Warm Coral & Rosso Bo Watercolor Header Wash -->
        <div
          class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1100px] h-[520px] rounded-full opacity-25 filter blur-3xl mix-blend-multiply"
          style="background: radial-gradient(ellipse at 50% 20%, #D44E42 0%, #8C222C 45%, #B87266 70%, transparent 85%);"
        ></div>
        <div
          class="absolute -top-24 -left-20 w-[480px] h-[480px] rounded-full opacity-20 filter blur-2xl mix-blend-multiply"
          style="background: radial-gradient(circle at 30% 30%, #D44E42 0%, #8C222C 55%, transparent 80%);"
        ></div>
        <div
          class="absolute -top-24 -right-20 w-[480px] h-[480px] rounded-full opacity-20 filter blur-2xl mix-blend-multiply"
          style="background: radial-gradient(circle at 70% 30%, #B87266 0%, #D44E42 50%, transparent 80%);"
        ></div>

        <!-- Bottom-Right Warm Bo Red & Rose Bloom -->
        <div
          class="absolute -bottom-36 -right-36 w-[600px] h-[600px] rounded-full opacity-20 filter blur-3xl mix-blend-multiply"
          style="background: radial-gradient(circle at 65% 65%, #D44E42 0%, #8C222C 50%, transparent 85%);"
        ></div>
        <div
          class="absolute bottom-10 right-10 w-[380px] h-[380px] rounded-full opacity-15 filter blur-2xl mix-blend-multiply"
          style="background: radial-gradient(circle at 70% 70%, #B87266 0%, #8C222C 55%, transparent 75%);"
        ></div>
      </div>

      <!-- Subtle paper noise texture / grain -->
      <div
        class="absolute inset-0 opacity-[0.025]"
        style="background-image: radial-gradient(#1B140E 1px, transparent 1px); background-size: 24px 24px;"
      ></div>
    </div>

    <!-- Main site content above background washes -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <!-- Vanilla Client Scripts (Smooth scroll, Navbar, Section observer) -->
    <script>
      // Smooth scroll
      document.querySelectorAll('a.scroll-link').forEach((link) => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href');
          if (href && href.startsWith('#')) {
            e.preventDefault();
            const target = document.querySelector(href);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        });
      });

      // Navbar scroll effect
      const navbar = document.getElementById('navbar');
      function handleNavbarScroll() {
        if (!navbar) return;
        if (window.scrollY > 20) {
          navbar.classList.add('scrolled');
        } else {
          navbar.classList.remove('scrolled');
        }
      }
      window.addEventListener('scroll', handleNavbarScroll, { passive: true });
      handleNavbarScroll();

      // Intersection Observer for section fade-in
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.06 }
        );

        document.querySelectorAll('section').forEach((el) => {
          el.classList.add('section-fade-in');
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>
